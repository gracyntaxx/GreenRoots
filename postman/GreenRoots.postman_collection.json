    {
      "name": "Payments & PayPal",
      "item": [
        {
          "name": "Create PayPal Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scope\": \"order\",\n  \"referenceId\": \"order_ricehusk_500\",\n  \"amount\": 1200,\n  \"idempotencyKey\": \"test_idem_001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/functions/v1/payments/create-order",
              "host": ["{{baseUrl}}"],
              "path": ["functions", "v1", "payments", "create-order"]
            }
          }
        },
        {
          "name": "Confirm Payment (Capture)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"pay_order_ricehusk\",\n  \"outcome\": \"approve\"\n}"
