        },
        {
          "name": "Simulate PayPal Webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "paypal-auth-algo", "value": "SHA256withRSA" },
              { "key": "paypal-transmission-id", "value": "test-transmission-001" },
              { "key": "paypal-transmission-sig", "value": "test-signature" },
              { "key": "paypal-transmission-time", "value": "2026-11-09T12:00:00Z" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-EVENT-998877\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"create_time\": \"2026-11-09T12:00:00Z\",\n  \"resource\": {\n    \"id\": \"CAP-TEST-123\",\n    \"status\": \"COMPLETED\",\n    \"amount\": {\n      \"currency_code\": \"USD\",\n      \"value\": \"14.28\"\n    },\n    \"supplementary_data\": {\n      \"related_ids\": {\n        \"order_id\": \"PP-7K2A1M4QX\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/functions/v1/paypal-webhook",
              "host": ["{{baseUrl}}"],
              "path": ["functions", "v1", "paypal-webhook"]
            }
          }
        }
